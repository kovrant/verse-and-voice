NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Service-role secret (Supabase dashboard → Project Settings → API → service_role).
# Server-side only — used to create/reset student logins. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Domain used to synthesize a student's login email from their username.
# Must be a stable value; changing it breaks existing student logins.
NEXT_PUBLIC_STUDENT_EMAIL_DOMAIN=students.quran-academy.app
